from collections import deque
String=input("Enter a string:")
dq=deque()
for char in String:
    if char.isalnum():
        dq.append(char.lower())
is_palindrome=True
while len(dq)>1:
    front=dq.popleft()
    rear=dq.pop()
    if front!= rear:
        is_palindrome=False
        break
if is_palindrome:
    print(" The string is palindrome:")
else:
     print("The string is not palindrome:")
